{
    "folders":
    [
        // Root folder
        {
            "name": "<root>",
            "path": ".",
            "index_exclude_patterns": [
                // Uninteresting folders
                // Python
                "**/.venv",
                // Rust
                "**/target",
                // Softwares
                ".idea/*",
                // Files
                "*.css", "*.js", "*.md", "*.log",
            ],
            "index_include_patterns": ["*.py"],
            "folder_exclude_patterns": [
                // Python
                "*.egg-info", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".venv", "__pycache__", "build", "dist", "coverage-reports",
            ],
            "file_exclude_patterns": [
                // Python
                ".coverage", ".python-version", ".envrc", "uv.lock",
            ],
        },
